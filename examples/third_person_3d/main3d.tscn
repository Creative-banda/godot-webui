[sub_resource type="Shader" id="Shader_10"]
code = "shader_type spatial;
varying vec3 wpos;
uniform vec3 base_color : source_color = vec3(0.27, 0.36, 0.30);
uniform vec3 line_color : source_color = vec3(0.55, 0.70, 0.60);
void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
	vec2 p = wpos.xz * 0.5;
	vec2 g = abs(fract(p - 0.5) - 0.5) / fwidth(p);
	float line = 1.0 - min(min(g.x, g.y), 1.0);
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 0.9;
}
"

